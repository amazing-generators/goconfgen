func toAnySlice(valueObj any) ([]any, bool) {
if valueObj == nil {
return nil, false
}
switch typedValue := valueObj.(type) {
case []any:
return typedValue, true
case []string:
resultArr := make([]any, 0, len(typedValue))
for _, itemText := range typedValue {
resultArr = append(resultArr, itemText)
}
return resultArr, true
}
return nil, false
}

func toInt64(valueObj any) (int64, bool) {
switch typedValue := valueObj.(type) {
case int:
return int64(typedValue), true
case int8:
return int64(typedValue), true
case int16:
return int64(typedValue), true
case int32:
return int64(typedValue), true
case int64:
return typedValue, true
case uint:
if uint64(typedValue) > uint64(1<<63-1) {
return 0, false
}
return int64(typedValue), true
case uint8:
return int64(typedValue), true
case uint16:
return int64(typedValue), true
case uint32:
return int64(typedValue), true
case uint64:
if typedValue > uint64(1<<63-1) {
return 0, false
}
return int64(typedValue), true
case float64:
if math.Trunc(typedValue) != typedValue || typedValue < float64(-1<<63) || typedValue > float64(1<<63-1) {
return 0, false
}
return int64(typedValue), true
}
return 0, false
}

func toUint64(valueObj any) (uint64, bool) {
switch typedValue := valueObj.(type) {
case uint:
return uint64(typedValue), true
case uint8:
return uint64(typedValue), true
case uint16:
return uint64(typedValue), true
case uint32:
return uint64(typedValue), true
case uint64:
return typedValue, true
case int:
if typedValue < 0 {
return 0, false
}
return uint64(typedValue), true
case int64:
if typedValue < 0 {
return 0, false
}
return uint64(typedValue), true
case float64:
if math.Trunc(typedValue) != typedValue || typedValue < 0 || typedValue > float64(^uint64(0)) {
return 0, false
}
return uint64(typedValue), true
}
return 0, false
}

func toFloat64(valueObj any) (float64, bool) {
switch typedValue := valueObj.(type) {
case float32:
return float64(typedValue), true
case float64:
return typedValue, true
case int:
return float64(typedValue), true
case int64:
return float64(typedValue), true
case uint64:
return float64(typedValue), true
}
return 0, false
}

func validateSignedRange(valueVal int64, bitSizeVal int) bool {
if bitSizeVal <= 0 || bitSizeVal >= 64 {
return true
}
minVal := -(int64(1) << (bitSizeVal - 1))
maxVal := (int64(1) << (bitSizeVal - 1)) - 1
return valueVal >= minVal && valueVal <= maxVal
}

func validateUnsignedRange(valueVal uint64, bitSizeVal int) bool {
if bitSizeVal <= 0 || bitSizeVal >= 64 {
return true
}
maxVal := (uint64(1) << bitSizeVal) - 1
return valueVal <= maxVal
}

func validateFloatRange(valueVal float64, bitSizeVal int) bool {
if bitSizeVal == 32 {
return !math.IsInf(valueVal, 0) && !math.IsNaN(valueVal) && valueVal >= -math.MaxFloat32 && valueVal <= math.MaxFloat32
}
return !math.IsInf(valueVal, 0) && !math.IsNaN(valueVal)
}

func parseSize(textValue string) (uint64, error) {
textValue = strings.TrimSpace(strings.ToLower(textValue))
if textValue == "" {
return 0, fmt.Errorf("size is empty")
}
unitObjArr := []struct {
SuffixText string
FactorVal  uint64
}{
{"tib", 1024 * 1024 * 1024 * 1024},
{"tb", 1000 * 1000 * 1000 * 1000},
{"gib", 1024 * 1024 * 1024},
{"gb", 1000 * 1000 * 1000},
{"mib", 1024 * 1024},
{"mb", 1000 * 1000},
{"kib", 1024},
{"kb", 1000},
{"b", 1},
}
factorVal := uint64(1)
for _, itemObj := range unitObjArr {
if strings.HasSuffix(textValue, itemObj.SuffixText) {
textValue = strings.TrimSpace(strings.TrimSuffix(textValue, itemObj.SuffixText))
factorVal = itemObj.FactorVal
break
}
}
if textValue == "" {
return 0, fmt.Errorf("size numeric part is empty")
}
if strings.HasPrefix(textValue, "-") {
return 0, fmt.Errorf("size must be non-negative")
}
if strings.Contains(textValue, ".") {
floatVal, err := strconv.ParseFloat(textValue, 64)
if err != nil {
return 0, err
}
if math.IsNaN(floatVal) || math.IsInf(floatVal, 0) || floatVal < 0 {
return 0, fmt.Errorf("size must be non-negative")
}
scaledVal := floatVal * float64(factorVal)
if math.IsNaN(scaledVal) || math.IsInf(scaledVal, 0) || scaledVal > float64(math.MaxUint64) {
return 0, fmt.Errorf("size is too large")
}
return uint64(scaledVal), nil
}
valueVal, err := strconv.ParseUint(textValue, 10, 64)
if err != nil {
return 0, err
}
if factorVal > 0 && valueVal > math.MaxUint64/factorVal {
return 0, fmt.Errorf("size is too large")
}
return valueVal * factorVal, nil
}

func parseDurationText(textValue string) (time.Duration, error) {
return time.ParseDuration(strings.TrimSpace(textValue))
}

func toCanonicalSizeText(sizeVal uint64) string {
unitObjArr := []struct {
SuffixText string
FactorVal  uint64
}{
{"TiB", 1024 * 1024 * 1024 * 1024},
{"GiB", 1024 * 1024 * 1024},
{"MiB", 1024 * 1024},
{"KiB", 1024},
}
for _, itemObj := range unitObjArr {
if sizeVal >= itemObj.FactorVal && sizeVal%itemObj.FactorVal == 0 {
return fmt.Sprintf("%d%s", sizeVal/itemObj.FactorVal, itemObj.SuffixText)
}
}
return fmt.Sprintf("%dB", sizeVal)
}

func parseCSV(textValue string) []string {
textValue = strings.TrimSpace(textValue)
if textValue == "" {
return nil
}
partTextArr := strings.Split(textValue, ",")
resultArr := make([]string, 0, len(partTextArr))
for _, partText := range partTextArr {
resultArr = append(resultArr, strings.TrimSpace(partText))
}
return resultArr
}

func parseStringMapShorthand(textValue string) (map[string]string, error) {
resultObj := make(map[string]string)
for _, itemText := range parseCSV(textValue) {
partTextArr := strings.SplitN(itemText, "=", 2)
if len(partTextArr) != 2 {
return nil, fmt.Errorf("invalid map item [%s]", itemText)
}
keyText := strings.TrimSpace(partTextArr[0])
if err := validateShorthandKey(keyText); err != nil {
return nil, err
}
resultObj[keyText] = strings.TrimSpace(partTextArr[1])
}
return resultObj, nil
}

func parseJSONStringMap[T any](textValue string) (T, error) {
var resultObj T
err := json.Unmarshal([]byte(textValue), &resultObj)
return resultObj, err
}

func validateShorthandKey(keyText string) error {
if len(keyText) == 0 || len(keyText) > 16 {
return fmt.Errorf("invalid shorthand key length [%s]", keyText)
}
for _, itemRune := range keyText {
switch {
case itemRune >= 'a' && itemRune <= 'z':
case itemRune >= 'A' && itemRune <= 'Z':
case itemRune >= '0' && itemRune <= '9':
case itemRune == '_':
default:
return fmt.Errorf("invalid shorthand key [%s]", keyText)
}
}
return nil
}

type runtimeFlagInterface interface {
String() string
IsSeen() bool
Text() string
Set(valueText string) error
}

type runtimeStringFlagObj struct {
ValueText string
SeenFlag  bool
}

type runtimeBoolFlagObj struct {
ValueFlag bool
SeenFlag  bool
}

func (obj *runtimeStringFlagObj) String() string {
return obj.Text()
}

func (obj *runtimeStringFlagObj) Text() string {
if obj == nil {
return ""
}
return obj.ValueText
}

func (obj *runtimeStringFlagObj) IsSeen() bool {
return obj != nil && obj.SeenFlag
}

func (obj *runtimeStringFlagObj) Set(valueText string) error {
obj.ValueText = valueText
obj.SeenFlag = true
return nil
}

func (obj *runtimeBoolFlagObj) String() string {
return obj.Text()
}

func (obj *runtimeBoolFlagObj) Text() string {
if obj == nil || !obj.ValueFlag {
return "false"
}
return "true"
}

func (obj *runtimeBoolFlagObj) IsSeen() bool {
return obj != nil && obj.SeenFlag
}

func (obj *runtimeBoolFlagObj) Set(valueText string) error {
valueText = strings.TrimSpace(strings.ToLower(valueText))
switch valueText {
case "true", "1", "yes", "y", "on":
obj.ValueFlag = true
case "false", "0", "no", "n", "off":
obj.ValueFlag = false
default:
return fmt.Errorf("invalid bool value: %s", valueText)
}
obj.SeenFlag = true
return nil
}

func (obj *runtimeBoolFlagObj) IsBoolFlag() bool {
return true
}

func normalizeAnyMap(valueObj any) any {
switch typedValue := valueObj.(type) {
case map[string]any:
keyTextArr := make([]string, 0, len(typedValue))
for keyText := range typedValue {
keyTextArr = append(keyTextArr, keyText)
}
sort.Strings(keyTextArr)
resultObj := make(map[string]any, len(typedValue))
for _, keyText := range keyTextArr {
resultObj[keyText] = normalizeAnyMap(typedValue[keyText])
}
return resultObj
case []any:
resultArr := make([]any, 0, len(typedValue))
for _, itemObj := range typedValue {
resultArr = append(resultArr, normalizeAnyMap(itemObj))
}
return resultArr
case float64:
maxIntVal := int(^uint(0) >> 1)
minIntVal := -maxIntVal - 1
if math.Trunc(typedValue) == typedValue && typedValue >= float64(minIntVal) && typedValue <= float64(maxIntVal) {
return int(typedValue)
}
return typedValue
default:
return typedValue
}
}

