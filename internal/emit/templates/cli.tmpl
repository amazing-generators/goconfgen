func applyCLIArgs(cfgObj *ConfigObj, argsArr []string) error {
flagSet := flag.NewFlagSet("generated", flag.ContinueOnError)
flagsObj := newCLIFlags()
flagsObj.registerFlags(flagSet)
if err := flagSet.Parse(argsArr); err != nil {
return err
}
return flagsObj.applyFlags(cfgObj)
}

func ApplyCLI(obj *ConfigObj, argsArr []string) error {
if argsArr == nil {
return fmt.Errorf("argsArr must not be nil; pass empty slice if no CLI args")
}
return applyCLIArgs(obj, argsArr)
}

