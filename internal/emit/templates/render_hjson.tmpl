func (obj *ConfigObj) RenderHJSON(partialFlag bool) ([]byte, error) {
var bufferObj bytes.Buffer
includeFlag, err := appendHJSONConfigObj(&bufferObj, obj, partialFlag, "", true)
if err != nil {
return nil, err
}
if !includeFlag {
return []byte("{}\n"), nil
}
return bufferObj.Bytes(), nil
}

