package {{ .PackageName }}

import (
"bytes"
"encoding/json"
"strconv"
)

// // // // // // // // // //

func (obj *ConfigObj) RenderJSON(partialFlag bool) ([]byte, error) {
var bufferObj bytes.Buffer
includeFlag, err := appendJSONConfigObj(&bufferObj, obj, partialFlag, "", true)
if err != nil {
return nil, err
}
if !includeFlag {
return []byte("{}\n"), nil
}
return bufferObj.Bytes(), nil
}

{{ template "appendJSONBranch" .RootObj }}

{{ define "appendJSONBranch" }}
    func appendJSON{{ .TypeNameText }}(bufferObj *bytes.Buffer, obj *ConfigObj, partialFlag bool, indentText string, rootFlag bool) (bool, error) {
    var bodyObj bytes.Buffer
    includeFlag := false
    firstFlag := true
    {{- range .EntryObjArr }}
        {{- if .BranchObj }}
            {
            var childBufferObj bytes.Buffer
            childIncludeFlag, err := appendJSON{{ .BranchObj.TypeNameText }}(&childBufferObj, obj, partialFlag, indentText+"  ", false)
            if err != nil {
            return false, err
            }
            if childIncludeFlag || !partialFlag {
            appendJSONEntryPrefix(&bodyObj, &firstFlag, indentText, {{ quote .BranchObj.KeyText }})
            bodyObj.Write(childBufferObj.Bytes())
            includeFlag = true
            }
            }
        {{- else if .FieldObj }}
            {
            if !partialFlag || obj.hasPath({{ quote .FieldObj.PathText }}) {
            valueObj, err := renderValue{{ goName .FieldObj.PathText }}(obj)
            if err != nil {
            return false, err
            }
            valueArr, err := json.Marshal(valueObj)
            if err != nil {
            return false, err
            }
            appendJSONEntryPrefix(&bodyObj, &firstFlag, indentText, {{ quote .FieldObj.KeyText }})
            bodyObj.Write(valueArr)
            includeFlag = true
            }
            }
        {{- end }}
    {{- end }}
    if !includeFlag && partialFlag {
    return false, nil
    }
    bufferObj.WriteString("{")
    if bodyObj.Len() > 0 {
    bufferObj.WriteString("\n")
    bufferObj.Write(bodyObj.Bytes())
    bufferObj.WriteString("\n")
    bufferObj.WriteString(indentText)
    }
    bufferObj.WriteString("}")
    if rootFlag {
    bufferObj.WriteString("\n")
    }
    return true, nil
    }

    {{- range .BranchObjArr }}
        {{ template "appendJSONBranch" . }}
    {{- end }}
{{ end }}

func appendJSONEntryPrefix(bufferObj *bytes.Buffer, firstFlag *bool, indentText string, keyText string) {
if !*firstFlag {
bufferObj.WriteString(",\n")
}
*firstFlag = false
bufferObj.WriteString(indentText)
bufferObj.WriteString("  ")
bufferObj.WriteString(strconv.Quote(keyText))
bufferObj.WriteString(": ")
}
